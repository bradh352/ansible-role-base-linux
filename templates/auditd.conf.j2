#
# This file controls the configuration of the audit daemon
#

log_file = /var/log/audit/audit.log
log_format = RAW
log_group = root
priority_boost = 4
flush = INCREMENTAL
freq = 20
num_logs = 5
name_format = NONE
##name = mydomain
max_log_file = 70
max_log_file_action = ROTATE
space_left = 75
{% if base_linux_auditd_action_mail_acct is defined %}
space_left_action = email
action_mail_acct = {{ base_linux_auditd_action_mail_acct }}
{% else %}
space_left_action = syslog
{% endif %}
admin_space_left = 50
admin_space_left_action = {{ base_linux_auditd_admin_space_left_action }}
disk_full_action = ROTATE
disk_error_action = {{ base_linux_auditd_disk_error_action }}
##tcp_listen_port = 
tcp_listen_queue = 5
tcp_max_per_addr = 1
##tcp_client_ports = 1024-65535
tcp_client_max_idle = 0
enable_krb5 = no
krb5_principal = auditd
##krb5_key_file = /etc/audit/audit.key
